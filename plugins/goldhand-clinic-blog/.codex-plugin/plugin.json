    "defaultPrompt": [
      "\uc815\ubcf4\ud615 \uc8fc\uc81c 10\uac1c\ub97c \uba3c\uc800 \ucd94\ucc9c\ud574\uc918. \ubc88\ud638\ub85c \uace0\ub974\uac70\ub098 \uc6d0\ud558\ub294 \uc8fc\uc81c\ub97c \uc9c1\uc811 \uc785\ub825\ud560\uac8c.",
      "\uae08\uc190\ud55c\uc758\uc6d0 \uc815\ubcf4\uc804\ub2ec\ud615 \uae00\uc744 \uacf5\uac10 \uc9c8\ubb38, \uae08\uc190\ud55c\uc758\uc6d0 \uc18c\uac1c \ud45c, 3\ubd84 \ud574\uacb0 \uc608\uace0, \uc81c\ubaa9 \uc22b\uc790\uc640 \uc77c\uce58\ud558\ub294 \ubc88\ud638 \ub2f5, \uc804\uccb4 \uc815\ub9ac, CTA \uc21c\uc11c\ub85c \uc791\uc131\ud574\uc918.",
      "\uc2e4\uc81c \ud55c\uad6d\uc778\uc774 \ud3c9\uc18c \uc4f0\ub294 \uc0dd\ud65c\uc5b4\ub85c \ud3c9\ubb38\ub9cc \uc791\uc131\ud558\uace0, \ub0b4\uac00 \uc2b9\uc778\ud558\uae30 \uc804\uc5d0\ub294 HTML\uc774\ub098 \uc774\ubbf8\uc9c0\ub97c \ub9cc\ub4e4\uc9c0 \ub9c8.",
      "\uc9c0\uc815\ub41c \ud55c \uac00\uc9c0 \uc815\ubcf4\uc804\ub2ec \uad6c\uc870\ub9cc \uc0ac\uc6a9\ud574\uc918."
