    ],
    "defaultPrompt": [
      "\uae08\uc190\ud55c\uc758\uc6d0 \ube14\ub85c\uadf8 \uae00\uc744 \uc791\uc131\ud574\uc918.",
      "\uae00 \uc8fc\uc81c\ub294 \uc624\uc2ed\uacac \uce58\ub8cc \uc2dc\uae30, \uba54\uc778\ud0a4\uc6cc\ub4dc\ub294 \uad11\uc8fc \ud55c\uc758\uc6d0\uc73c\ub85c \uae08\uc190\ud55c\uc758\uc6d0 \ube14\ub85c\uadf8 \uae00\uc744 \uc791\uc131\ud574\uc918.",
      "\uc8fc\uc81c\uc640 \uba54\uc778\ud0a4\uc6cc\ub4dc\uc5d0 \ub9de\ub294 \uc81c\ubaa9 5\uac1c\ub97c \uba3c\uc800 \ucd94\ucc9c\ud558\uace0, \ub0b4\uac00 \ubc88\ud638\ub97c \uace0\ub974\uac70\ub098 \uc81c\ubaa9\uc744 \uc9c1\uc811 \uc785\ub825\ud55c \ub4a4 \uae08\uc190\ud55c\uc758\uc6d0 \ube14\ub85c\uadf8 \uae00\uc744 \uc644\uc131\ud574\uc918."
