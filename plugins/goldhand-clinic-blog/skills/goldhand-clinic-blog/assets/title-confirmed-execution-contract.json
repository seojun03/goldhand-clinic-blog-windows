      "expectedNext": "topic-priority-interview",
      "mustAskUserAgain": true,
      "afterResponse": "automatic-user-centered-production"
    },
    {
      "id": "direct-title-without-number",
      "input": "사용자가 숫자가 없는 제목을 직접 입력함",
      "answerCountResolution": "use-distinct-user-priorities-after-numberless-question",
      "expectedNext": "topic-priority-interview",
      "mustAskUserAgain": true,
      "afterResponse": "automatic-user-centered-production"
    }
