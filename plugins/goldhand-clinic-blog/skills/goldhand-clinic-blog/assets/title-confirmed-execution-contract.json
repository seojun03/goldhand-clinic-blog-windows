  "scenarioTests": [
    {
      "id": "recommended-numbered-title-selected",
      "input": "사용자가 추천 제목 가운데 하나를 선택함",
      "answerCountResolution": "use-title-promise",
      "expectedNext": "topic-priority-interview",
      "mustAskUserAgain": true,
      "afterResponse": "automatic-user-centered-production"
    },
    {
      "id": "direct-numbered-title",
      "input": "사용자가 숫자가 들어간 제목을 직접 입력함",
