{
  "schemaVersion": 1,
  "contractId": "goldhand-topic-recommendations-v2",
  "defaultWorkflowStage": "topic-recommendation-first",
  "candidateCount": 10,
  "numberedOutputRequired": true,
  "displayFormat": "{number}. {keyword}",
  "keywordOnly": true,
  "displayOrder": "source-order",
  "descriptionsQuestionsAndSubtitlesForbidden": true,
  "numberingStart": 1,
  "numberingEnd": 10,
  "sourceAsset": "topic-keyword-library.json",
  "sourceCollection": "topicKeywords",
  "sourceTextField": "keyword",
  "autoEligibleRequired": true,
  "informationTopicOnly": true,
  "distinctTopicTextRequired": true,
  "maximizeTopicClusterDiversity": true,
  "researchRequiredBeforeRecommendations": false,
  "displaySourceMetadata": false,
  "selectionPrompt": "1~10번 중 작성할 주제를 선택하거나, 원하는 주제를 직접 입력해 주세요.",
  "numberSelection": {
    "minimum": 1,
    "maximum": 10,
    "preserveExactCandidateText": true,
    "mustNotReplaceWithDetailedTopicIdea": true
  },
  "customTopic": {
    "allowed": true,
    "preserveExactUserWording": true,
    "directTopicSkipsRecommendations": true,
    "recentArticleOverlapMayBlock": false,
    "silentRewriteAllowed": false
  }
}
